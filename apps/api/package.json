{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "go build -o dist/api ./cmd/api",
    "start": "go run ./cmd/api",
    "start:dev": "go run ./cmd/api",
    "start:prod": "./dist/api",
    "typecheck": "go build ./...",
    "lint": "go vet ./... && test -z \"$(gofmt -l .)\"",
    "format": "gofmt -w .",
    "test": "go test ./...",
    "db:generate": "go tool sqlc generate",
    "db:migrate": "go run ./cmd/api migrate up",
    "db:deploy": "go run ./cmd/api migrate up",
    "db:status": "go run ./cmd/api migrate status"
  }
}
